# Copy these values into your local environment or Render's secret variables.
# Do not commit an actual .env file. Generate JWT_SECRET_BASE64 using:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/food_mobo_chain?retryWrites=true&w=majority
JWT_SECRET_BASE64=REPLACE_WITH_NEW_RANDOM_BASE64_KEY
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
APP_SECURE_COOKIES=true
SPRING_PROFILES_ACTIVE=prod
